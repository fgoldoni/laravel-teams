{
    "name": "goldoni/laravel-teams",
    "description": "Team management for Laravel 12",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Goldoni\\LaravelTeams\\": "src/",
            "Goldoni\\LaravelTeams\\Database\\Factories\\": "database/factories/",
            "Goldoni\\LaravelTeams\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goldoni\\LaravelTeams\\Providers\\TeamsServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
